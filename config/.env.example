# ============================================================================
#  Signo — Environment Variables Reference
#  Copy this file to .env and update values for your deployment.
# ============================================================================

# ─── Django Settings ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,signo-web

# ─── Ollama AI Models ───────────────────────────────────────────────────────
# Each model role can be swapped independently
VLM_MODEL=qwen2-vl:2b          # Vision Language Model (sign classifier)
JUDGE_MODEL=qwen2.5:3b         # Judge Agent (debate arbitrator)
TRANSLATOR_MODEL=qwen2.5:3b    # Sentence reconstructor & grammar smoother

# ─── Ollama Connection ───────────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434  # Docker internal DNS (use http://localhost:11434 for local dev)

# ─── Inference Tuning ────────────────────────────────────────────────────────
# Set to "1" to bypass VLM arbitration (LSTM-only mode, faster but less accurate)
SIGNO_BYPASS_ARBITRATION=0
