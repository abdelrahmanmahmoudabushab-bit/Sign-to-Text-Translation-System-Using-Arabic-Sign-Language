# ─── IDE & OS files ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

# ─── Docker files (don't copy themselves into image) ─────────────
Dockerfile
docker-compose.yml
.dockerignore

# ─── Media demo files ───────────────────────────────────────────
PBL.mp4

# ─── Desktop/systemd configs (handled by Docker now) ────────────
signo-app.desktop
signo.service

# ─── Nginx config (mounted as volume, not baked into app image) ──
nginx/
