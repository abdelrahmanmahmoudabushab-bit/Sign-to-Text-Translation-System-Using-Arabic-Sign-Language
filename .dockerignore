.venv/
venv/
env/

# ─── Git ─────────────────────────────────────────────────────────
.git/
.gitignore

# ─── Python cache ────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ─── Datasets (30+ GB — NOT needed at runtime) ──────────────────
datasets/

